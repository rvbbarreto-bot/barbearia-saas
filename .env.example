# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Variáveis para Docker Compose + API (referência única na raiz)
#
#  INSTRUÇÕES:
#  1. Copie: cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
#  2. Substitua <PLACEHOLDER> ou use os exemplos SEGUROS da secção “EXEMPLO QA LOCAL” abaixo.
#  3. NUNCA commite `.env`.
#
#  Documentação passo a passo: docs/QA_AMBIENTE_LOCAL.md
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── API — porta ──────────────────────────────────────────────────────────────
# PORT: porta HTTP da API (default 3000). Dentro do Docker a API escuta 3000.
PORT=3000
# Opcional: alias útil em scripts externos (se PORT estiver vazio, a API usa API_PORT).
# API_PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# OBRIGATÓRIO no Compose: POSTGRES_* para o serviço postgres.
# DATABASE_URL: OBRIGATÓRIA para a API — deve coincidir com utilizador/senha/base abaixo.
# Nota: no `docker-compose.yml`, o serviço `api` sobrescreve DATABASE_URL/REDIS_URL para hosts
# internos `postgres`/`redis` (evita confundir com URLs de npm dev em localhost).
#
# --- Dentro do Docker Compose (host interno `postgres`, porta 5432) ---
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
#
# --- npm local + Postgres só no Docker (porta publicada 5432 no host) ---
# DATABASE_URL=postgresql://barbearia:change-me-local-postgres@127.0.0.1:5432/barbearia_saas

POSTGRES_DB=barbearia_saas
POSTGRES_USER=barbearia
POSTGRES_PASSWORD=<SENHA_FORTE_POSTGRES>

# ── Redis ────────────────────────────────────────────────────────────────────
# OBRIGATÓRIO no Compose: REDIS_PASSWORD (serviço redis com --requirepass).
# REDIS_URL: OBRIGATÓRIA para a API.
#
# --- Dentro do Docker Compose (host interno `redis`, porta 6379 no container) ---
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
#
# --- npm local + Redis do docker-compose.yml (mapa 6380:6379 no HOST) ---
# REDIS_URL=redis://:change-me-local-redis@127.0.0.1:6380

REDIS_PASSWORD=<SENHA_FORTE_REDIS>

# ── JWT ────────────────────────────────────────────────────────────────────────
# OBRIGATÓRIO para a API — mínimo 32 caracteres (ver apps/api/src/config/env.ts).
# Exemplo seguro fictício (NÃO usar em produção):
# JWT_SECRET=change-me-local-dev-secret-32chars-min-ok
JWT_SECRET=<JWT_SECRET_MIN_32_CHARS_RANDOM>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Auth rate limits ─────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW=1 minute
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=20
AUTH_LOGOUT_RATE_LIMIT_MAX=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ── Tenant rate limit ────────────────────────────────────────────────────────
TENANT_DEFAULT_RPM=300

# ── Outbox worker ─────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_CONCURRENCY=5
# QA/CT-101: força falha de envio ao provider (mensagem permanece pending com retry; nunca sent).
OUTBOX_FORCE_SEND_FAILURE=false

# ── CORS — origem do portal Vite dev ──────────────────────────────────────────
# Inclua também http://localhost:3001 se testar portal servido pelo Compose no host.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3001

# ── n8n (serviço Docker) ─────────────────────────────────────────────────────
# N8N_ENCRYPTION_KEY / N8N_BASIC_AUTH_PASSWORD são obrigatórios para o container subir.
# Comando para gerar chave: openssl rand -hex 16
N8N_ENCRYPTION_KEY=<RANDOM_32_CHARS_HEX>
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<SENHA_FORTE_N8N>
# URL “pública” que o n8n anuncia para webhooks — no compose host usa-se a porta 5679:
N8N_WEBHOOK_URL=http://localhost:5679/
# Token enviado pelo n8n em x-webhook-token; deve igualar tenants.webhook_token.
# Seed demo: demo_webhook_token_change_me (ver database/seeds/001_demo.sql).
# Se omitir no .env, docker-compose define default igual ao seed apenas para DEV/QA.
N8N_WEBHOOK_TOKEN=<TOKEN_N8N_PARA_CORE_API_OU_demo_webhook_token_change_me>

# ── Evolution API (WhatsApp) — opcional na API ───────────────────────────────
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=<API_KEY_EVOLUTION>

# ── OpenAI — opcional (credencial pode ser só no n8n) ─────────────────────────
OPENAI_API_KEY=<OPENAI_API_KEY>

# ── Frontend dev (apenas documentação — não usado pelo Docker Compose) ──────
# Porta do Vite (opcional): export VITE_DEV_SERVER_PORT=5173
# WEB_PORT não é lido pela API; portal Compose usa 3001→80 no docker-compose.yml.

# ── Feature flags (DEV/QA — defaults seguros) ─────────────────────────────────
RECALL_ENABLED=false
WAITLIST_SLOT_NOTIFY_ENABLED=false
WAITLIST_SWEEP_ENABLED=false
PIX_REAL_PROVIDER_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════════════
# EXEMPLO QA LOCAL (valores fictícios — copiar para .env só em máquina isolada)
# POSTGRES_PASSWORD=change-me-local-postgres
# REDIS_PASSWORD=change-me-local-redis
# JWT_SECRET=change-me-local-dev-secret-32chars-min-ok
# DATABASE_URL=postgresql://barbearia:change-me-local-postgres@postgres:5432/barbearia_saas
# REDIS_URL=redis://:change-me-local-redis@redis:6379
# N8N_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
# N8N_BASIC_AUTH_PASSWORD=change-me-local-n8n-login
# N8N_WEBHOOK_TOKEN=demo_webhook_token_change_me
# ═══════════════════════════════════════════════════════════════════════════════
