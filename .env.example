# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Template de variáveis de ambiente
#
#  INSTRUÇÕES:
#  1. Copie este arquivo: cp .env.example .env
#  2. Preencha TODOS os valores marcados com <PLACEHOLDER>
#  3. NUNCA commite o arquivo .env — ele está no .gitignore
#  4. A IA não gera segredos reais. Use os comandos sugeridos abaixo.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Comando para gerar senha: openssl rand -base64 32
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
POSTGRES_DB=barbearia_saas
POSTGRES_USER=barbearia
POSTGRES_PASSWORD=<SENHA_FORTE_POSTGRES>

# ── Redis ────────────────────────────────────────────────────────────────────
# Comando para gerar senha: openssl rand -base64 32
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
REDIS_PASSWORD=<SENHA_FORTE_REDIS>

# ── JWT ──────────────────────────────────────────────────────────────────────
# OBRIGATÓRIO — mínimo 64 caracteres aleatórios
# Comando: openssl rand -base64 64
# NUNCA use frases pessoais, nomes, datas ou dados identificáveis.
JWT_SECRET=<JWT_SECRET_MIN_64_CHARS_RANDOM>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Auth rate limits ─────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW=1 minute
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=20
AUTH_LOGOUT_RATE_LIMIT_MAX=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ── Tenant rate limit ────────────────────────────────────────────────────────
TENANT_DEFAULT_RPM=300

# ── Outbox worker ────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_CONCURRENCY=5

# ── CORS — domínio do frontend ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── n8n ──────────────────────────────────────────────────────────────────────
# Comando para gerar chave: openssl rand -hex 16
N8N_ENCRYPTION_KEY=<RANDOM_32_CHARS_HEX>
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<SENHA_FORTE_N8N>
N8N_WEBHOOK_URL=http://localhost:5678/
# Token que o workflow n8n envia no header x-webhook-token para o Core API.
# Deve corresponder ao campo webhook_token do tenant na tabela tenants.
# Comando: openssl rand -base64 32
N8N_WEBHOOK_TOKEN=<TOKEN_N8N_PARA_CORE_API>

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=<API_KEY_EVOLUTION>

# ── OpenAI (opcional — necessário apenas para agente de IA) ──────────────────
OPENAI_API_KEY=<OPENAI_API_KEY>

# ── Feature flags (DEV/QA — defaults seguros) ─────────────────────────────────
# Recall promocional (API + n8n workflow 03). Manter false até QA/gestão.
RECALL_ENABLED=false
# Waitlist: notificação ao libertar slot (WhatsApp/outbox). Default false.
WAITLIST_SLOT_NOTIFY_ENABLED=false
# Varredura periódica waitlist. Default false.
WAITLIST_SWEEP_ENABLED=false
# Integração PIX com PSP real. false até decisão PO (docs/ADR_PIX_PROVIDER.md).
PIX_REAL_PROVIDER_ENABLED=false
