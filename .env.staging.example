# ── Staging Environment — copie para .env.staging e preencha todos os valores ──

NODE_ENV=staging
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://barbearia:<SENHA_FORTE>@postgres:5432/barbearia_saas_staging
POSTGRES_DB=barbearia_saas_staging
POSTGRES_USER=barbearia
POSTGRES_PASSWORD=<SENHA_FORTE_POSTGRES>

# Redis
REDIS_URL=redis://:<SENHA_FORTE_REDIS>@redis:6379
REDIS_PASSWORD=<SENHA_FORTE_REDIS>

# JWT — mínimo 64 caracteres aleatórios
JWT_SECRET=<UUID_OU_RANDOM_64CHARS>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth rate limits
AUTH_RATE_LIMIT_WINDOW=1 minute
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=20
AUTH_LOGOUT_RATE_LIMIT_MAX=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Tenant rate limit
TENANT_DEFAULT_RPM=300

# Outbox worker
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_CONCURRENCY=5

# CORS — domínio do frontend
CORS_ORIGIN=https://app-staging.seudominio.com

# n8n
N8N_ENCRYPTION_KEY=<RANDOM_32_CHARS>
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<SENHA_FORTE_N8N>
N8N_WEBHOOK_URL=https://n8n-staging.seudominio.com/

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=<API_KEY_EVOLUTION>

# OpenAI (opcional)
OPENAI_API_KEY=<OPENAI_KEY>

# Docker — imagens com tag semver (obrigatório no docker-compose.staging; não usar :latest)
API_IMAGE=ghcr.io/sua-org/barbearia-api:0.4.0
WEB_IMAGE=ghcr.io/sua-org/barbearia-web:0.4.0
API_HOST=api-staging.seudominio.com
WEB_HOST=app-staging.seudominio.com
N8N_HOST=n8n-staging.seudominio.com
N8N_DB=n8n_staging
# Portal: tenant demo default (build-time VITE_ no Dockerfile web)
VITE_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
