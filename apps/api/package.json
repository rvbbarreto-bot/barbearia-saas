{
  "name": "barbearia-saas-api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm exec eslint -- src",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/**/*.integration.test.ts' --exclude 'src/**/*.ps06.test.ts'",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ps06": "vitest run --coverage --config vitest.ps06.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/jwt": "10.0.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.5.1",
    "@fastify/swagger-ui": "5.2.3",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "fastify": "5.8.5",
    "ioredis": "5.10.1",
    "pg": "8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "9.28.0",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vitest": "4.1.5"
  }
}
