      "name": "Catalogo",
      "item": [
        {
          "name": "GET /api/v1/services",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[02B] GET /api/v1/services — status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[02B] services — lista paginada', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j).to.have.property('data');",
                  "  pm.expect(j.data).to.be.an('array');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  const seed = pm.environment.get('qa_service_id');",
                  "  const row = j.data.find(s => s.id === seed) || j.data[0];",
                  "  if (row) pm.environment.set('service_id', row.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "url": "{{api_base_url}}/api/v1/services?page=1&limit=20"
          }
        },
        {
          "name": "GET /api/v1/professionals",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[02B] GET /api/v1/professionals — status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[02B] professionals — lista paginada', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j).to.have.property('data');",
                  "  pm.expect(j.data).to.be.an('array');",
                  "});",
                  "pm.test('[02B/03A] pelo menos 1 profissional com service_ids (seed)', () => {",
                  "  const j = pm.response.json();",
                  "  const linked = j.data.find(p => Array.isArray(p.service_ids) && p.service_ids.length > 0);",
                  "  pm.expect(linked, 'Rode docker compose down -v ou migration 101').to.exist;",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  const seedPro = pm.environment.get('qa_professional_id');",
                  "  const seedSvc = pm.environment.get('qa_service_id');",
                  "  let pref = j.data.find(p => p.id === seedPro);",
                  "  if (!pref) pref = j.data.find(p => Array.isArray(p.service_ids) && p.service_ids.length > 0);",
                  "  if (pref) {",
                  "    pm.environment.set('professional_id', pref.id);",
                  "    const sid = (pref.service_ids && pref.service_ids.includes(seedSvc)) ? seedSvc : pref.service_ids[0];",
                  "    if (sid) pm.environment.set('service_id', sid);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "url": "{{api_base_url}}/api/v1/professionals?page=1&limit=20"
          }
        },
